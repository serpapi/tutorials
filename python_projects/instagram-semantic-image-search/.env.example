# Copy this file to `.env` and fill in your own values.
# .env is gitignored. Never commit real keys.

# https://serpapi.com/manage-api-key
SERPAPI_API_KEY=your_serpapi_key_here

# https://jina.ai/  -> get a free API key (free tier, non-commercial)
JINA_API_KEY=your_jina_key_here

# Local Elasticsearch from `start-local` (curl -fsSL https://elastic.co/start-local | sh).
# ES_API_KEY is the ES_LOCAL_API_KEY value written to elastic-start-local/.env by that script.
ES_URL=http://localhost:9200
ES_API_KEY=your_es_local_api_key_here
